class Solution {
public:
    bool uniformArray(vector<int>& nums1) {
        bool hasOdd = false;
        bool hasEven = false;

        for (int x : nums1) {
            if (x % 2 == 0)
                hasEven = true;
            else
                hasOdd = true;
        }

        if (!hasOdd || !hasEven)
            return true;

        int minOdd = INT_MAX;

        for (int x : nums1) {
            if (x % 2 != 0)
                minOdd = min(minOdd, x);
        }

        for (int x : nums1) {
            if (x % 2 == 0 && x <= minOdd)
                return false;
        }

        return true;
    }
};

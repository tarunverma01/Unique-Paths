class Solution {
public:
    int maximumPopulation(vector<vector<int>>& logs) {
        vector<int> population(2051, 0);
        for (auto log : logs) {
            int birth = log[0];
            int death = log[1];

            population[birth]++;
            population[death]--;
        }
        int current = 0;
        int maxPopulation = 0;
        int answer = 1950;
        for (int year = 1950; year <= 2050; year++) {
            current += population[year];
            if (current > maxPopulation) {
                maxPopulation = current;
                answer = year;
            }
        }
        return answer;
    }
};

class Solution {
public:
    int countRotations(string s, int k) {
        int n = s.size();
        int ans=0;
        for(int i=0;i<n;i++){
            int score=0;
            for(int j=0;j<n-1;j++){
                char a = s[(i+j)%n];
                char b = s[(i+j+1)%n];
                if(a==b) score++;
            }
            if(score==k) ans++;
        }
        return ans;
    }
};

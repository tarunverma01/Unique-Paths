class Solution {
public:
    bool sumGame(string num) {
       int n = num.size(),mid=n/2,left=0,right=0,diff=0;
       for(int i=0;i<mid;i++){
        if(num[i]=='?'){
            left++;
        }else{
            diff+=num[i]-'0';
        }
       } 
        for(int i=mid;i<n;i++){
            if(num[i]=='?'){
                right++;
            }else{
                diff-=num[i]-'0';
            }
        }
        int qdiff = right-left;
        if(qdiff%2!=0){
            return true;
        }
        return diff != 9 * qdiff / 2;
    }
};
